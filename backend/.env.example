# Supabase project settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Service role key. Server-side only — it bypasses row level security.
# Never ship this to the browser or commit the filled-in .env.
SUPABASE_SERVICE_ROLE_KEY=

# The anon key is the one the public site would use, if you later switch the
# read path from snapshot files to live queries.
SUPABASE_ANON_KEY=
